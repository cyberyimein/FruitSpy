<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fruitspy.backend</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>mkdir -p "$HOME/Library/Logs/FruitSpy"; export FRUITSPY_RUNTIME_DIR="$HOME/Library/Application Support/FruitSpy/runtime"; exec "$HOME/Applications/FruitSpy.app/Contents/Resources/scripts/dev-backend.sh" &gt;&gt; "$HOME/Library/Logs/FruitSpy/backend.log" 2&gt;&amp;1</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>EnvironmentVariables</key>
    <dict/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>
